# Copy to .env and fill in. .env is git-ignored, scanned by the pre-commit hook,
# and blocked by GitHub push protection. Real values belong in the secrets
# manager or the repository's GitHub Environments — never in this file.

APP_ENV=development
LOG_LEVEL=info

# Postgres. In production this is injected at deploy time.
DATABASE_URL=postgresql+asyncpg://arteamis:arteamis@postgres:5432/arteamis
POSTGRES_USER=arteamis
POSTGRES_PASSWORD=changeme
POSTGRES_DB=arteamis

# Required in production; the app refuses to start without it.
JWT_SECRET=

# Third-party credentials — leave blank locally unless you need them.
OPENAI_API_KEY=
